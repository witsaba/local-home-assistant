# sdkconfig.defaults — embedded/iot_cams firmware defaults.
#
# Read by `idf.py reconfigure` on every fresh build. Each
# CONFIG_* here is the project floor; a developer can override
# per-machine via `idf.py menuconfig` (writes to gitignored
# `./sdkconfig`) or per CI run via `sdkconfig.ci`.
#
# Adding a value here without matching the same default in
# `components/provisioning/Kconfig.projbuild` is a bug — Kconfig
# will resolve the conflict in favor of the user's local config
# and the build will start ignoring one or the other.

# === Bootloader / flasher ===
#
# AI-Thinker ESP32-CAM comes populated with a 4 MB SPI flash
# (the partition label 'W25Q32'). Without the explicit 4 MB
# override, the bootloader rejects 4 KB of address space at
# the top of the chip and the boot log warns
# 'Detected size(4096k) larger than the size in the binary
# image header(2048k)'. Crystal is 40 MHz on every board
# revision we ship; DIO mode matches the AI-Thinker reference
# schematic.
CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y
CONFIG_ESPTOOLPY_FLASHFREQ_40M=y
CONFIG_ESPTOOLPY_FLASHMODE_DIO=y

# The AI-Thinker ESP32-CAM board uses a Boya BY25Q32 flash
# chip. Without this flag the build uses the generic flash
# driver which works but misses per-chip optimisations.
CONFIG_SPI_FLASH_SUPPORT_BOYA_CHIP=y

# === WiFi provisioning ===
#
# Mirrors `components/provisioning/Kconfig.projbuild`. With
# these set, a fresh checkout + flash puts the device into a
# softAP at `IoT-Cam_3091B0` (WPA2 passphrase from
# CONFIG_PROVISIONING_SOFTAP_PASS). The operator joins the
# softAP, opens http://192.168.4.1/ in a browser, and submits
# their home Wi-Fi credentials through an HTML form.
#
# Both `abcd1234` defaults are PLACEHOLDERS. Ship-time
# packaging must replace them with per-fleet values.
CONFIG_PROVISIONING_SOFTAP_PASS="abcd1234"
CONFIG_PROVISIONING_SERVICE_NAME_PREFIX="IoT-Cam"
CONFIG_PROVISIONING_DEVICE_NAME="iot-cam"

# Kept for the api's `pop` field. The captive flow does not
# prompt for a PoP (the WPA2 passphrase is the operator-visible
# security boundary). Future revisions may drop this.
CONFIG_PROVISIONING_POP="abcd1234"

# === Protocomm security model ===
#
# The captive portal does NOT use the IDF wifi_provisioning
# / protocomm manager, so these symbols are no longer
# pinned by the provisioning component. They are kept as a
# marker that the build resolves them only if a sibling
# component imports the relevant code paths. Leave them
# at the IDF default.
# CONFIG_ESP_PROTOCOMM_SUPPORT_SECURITY_VERSION_1=y

# === PSRAM ===
#
# The AI-Thinker ESP32-CAM ships with a 4 MB SPI PSRAM
# (Winbond W25Q32-style quad-SPI). Without this enabled the
# camera driver is forced into the single-DRAM-buffer path
# (~280 KB free DRAM after IDF allocations) and `fb_count=1`,
# which is the main reason captured JPEG frames at SVGA and
# above are tight on memory. Enabling PSRAM unlocks the
# double-buffer `fb_count=2, fb_location=CAMERA_FB_IN_PSRAM`
# path that `cam_reader.c` already selects via the
# `#if CONFIG_SPIRAM_SUPPORT` gate.
#
# Mode = QUAD matches the AI-Thinker reference schematic;
# SPEED = 40M aligns with the flash frequency. MALLOC exposes
# PSRAM as a malloc-capable region for `esp_camera_fb_get` /
# any future large allocation (camera_settings, future ring
# buffer, etc.).
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_QUAD=y
CONFIG_SPIRAM_SPEED_40M=y
CONFIG_SPIRAM_USE_MALLOC=y

# === HTTP server: socket pool ===
#
# The STA httpd is configured with max_open_sockets = 12 (see
# components/provisioning/src/sta_server.c) so that permanent
# /ws/cams viewers, the surveillance worker's /capture requests and
# the self-recovery loopback /health probe cannot exhaust the pool.
#
# IDF REQUIRES lwIP to have at least max_open_sockets + 3 sockets:
# the httpd reserves 3 for its own use (the listening socket and
# two UDP control sockets). See esp_http_server/src/httpd_main.c:
#
#     if (HTTPD_MAX_SOCKETS < config->max_open_sockets + 3) { ... }
#
# The lwIP default is CONFIG_LWIP_MAX_SOCKETS = 10, which caps the
# httpd at 7 sockets — and requesting 12 against it does NOT clamp
# down, it makes httpd_start() FAIL with ESP_ERR_INVALID_ARG, so the
# device comes up with no HTTP server at all and every endpoint
# (/whoami, /capture, /health) is unreachable while the WiFi looks
# perfectly healthy. This was caught on real hardware.
#
# 16 = 12 httpd sockets + 3 reserved + 1 spare. The extra sockets
# cost lwIP pcb memory only when a connection is actually active,
# so the idle footprint stays small; the free heap is reported on
# /health so the real cost is observable rather than assumed.
CONFIG_LWIP_MAX_SOCKETS=16

# === HTTP server: WebSocket support ===
#
# Required by the /ws/cams endpoint (W4 of
# feat/iot-cams-ws-cams-endpoint). ESP-IDF v5.5 ships the WS
# APIs in esp_http_server behind CONFIG_HTTPD_WS_SUPPORT; the
# default is OFF. With this on, httpd_uri_t gains
# `.is_websocket` and the httpd_ws_* family is exposed
# (httpd_ws_send_frame_async, httpd_ws_recv_frame,
# httpd_ws_client_info_t, etc.). The WS protocol stack itself
# (~6 KB flash) is only linked when this is on.
CONFIG_HTTPD_WS_SUPPORT=y

# === /ws/cams stream endpoint (W8) ===
#
# Mirrored from components/provisioning/Kconfig.projbuild.
# Change either one and re-run `idf.py reconfigure` to align
# the runtime config.
CONFIG_FIRMWARE_STREAM_FPS_DEFAULT=10
CONFIG_FIRMWARE_STREAM_FPS_MIN=1
CONFIG_FIRMWARE_STREAM_FPS_MAX=25
CONFIG_FIRMWARE_WS_PATH="/ws/cams"
CONFIG_FIRMWARE_WS_STATUS_PERIOD_MS=30000

# === Partition table ===
# The IDF v5.5 default (single 1 MB factory) leaves the firmware
# at 99% full once PSRAM is enabled — `app_check_size` prints
# a "1% free" warning. 1.5 MB matches `esp32-cam-surveillance`'s
# convention and gives headroom for the camera reader, the
# provisioning httpd, and any future WebSocket control plane.
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
CONFIG_PARTITION_TABLE_OFFSET=0x8000
